# Everything in config/ is personal except the demo, which is the shape every
# other config copies. There is deliberately only one shipped config.
config/*
!config/demo.yaml

# A bridge config may carry a gateway token, so it is never committed. The
# example lives in examples/, outside the Go package, because a bridge needs no
# config file at all — a file is only for mapping several agents.
/openclaw-bridge.yaml
/dev-openclaw.yaml

# Runtime session envelopes are ignored; .gitkeep keeps the folder in the repo.
sessions/*
!sessions/.gitkeep

# Every binary goes to bin/, which scripts/build.sh creates.
/bin/

# Binaries built in place with `go build -o ...` — still ignored so a stray
# build does not get committed. None of these is listed in a build file.
/vireo
/vireo-chat
/fakeagent
/openclaw-bridge

# Certificates are never committed. Development certs come from
# scripts/gen-certs.sh; production certs are supplied at run time, usually by
# mounting a directory over /app/certs. A tracked *.pem under certs/ means a
# private key is one `git commit -a` away from being published.
certs/*
!certs/.gitkeep
